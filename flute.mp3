<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Naredla Rama Chandra | culturalmusings.com</title>
<meta name="description" content="Official research hub of Naredla Rama Chandra. Exploring Sapta Swaras, 108 Karanas, and the Master Consciousness Protocol.">
<link rel="canonical" href="https://culturalmusings.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --cream:#fdf8f0;
  --cream2:#f5ede0;
  --cream3:#ede0cc;
  --navy:#1a2f4e;
  --navy2:#0f1e34;
  --gold:#b8862a;
  --gold2:#d4a43e;
  --gold3:#e8c06a;
  --muted:#7a6650;
  --text:#2c2416;
  --text2:#5a4a38;
  --border:rgba(184,134,42,0.2);
}
html{scroll-behavior:smooth;}
body{font-family:'Raleway',sans-serif;background:var(--cream);color:var(--text);overflow-x:hidden;}

/* ── SPLASH ── */
#splash{
  position:fixed;inset:0;z-index:9999;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:20px;background:var(--cream);
  transition:opacity 1.4s ease;
}
.splash-bg{position:absolute;inset:0;background:url('mywebsite/background_image.png') center/cover no-repeat;opacity:.35;}
.splash-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(253,248,240,.6) 0%,rgba(253,248,240,.35) 50%,rgba(253,248,240,.88) 100%);}
.splash-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;}
.splash-logo{width:100px;height:100px;border-radius:50%;object-fit:cover;border:3px solid rgba(184,134,42,.45);box-shadow:0 0 0 7px rgba(184,134,42,.08),0 8px 30px rgba(0,0,0,.15);margin-bottom:18px;}
.splash-om{font-family:'Cormorant Garamond',serif;font-size:5rem;color:var(--gold);animation:breathe 3s ease-in-out infinite;line-height:1;margin-bottom:8px;}
@keyframes breathe{0%,100%{opacity:.55;transform:scale(1);}50%{opacity:1;transform:scale(1.07);}}
.splash-rings{position:absolute;top:100px;left:50%;pointer-events:none;}
.ring{position:absolute;border-radius:50%;border:1px solid rgba(184,134,42,.18);transform:translate(-50%,-50%);animation:ripple 4s ease-in-out infinite;}
.ring:nth-child(1){width:170px;height:170px;}
.ring:nth-child(2){width:260px;height:260px;animation-delay:1s;}
.ring:nth-child(3){width:360px;height:360px;animation-delay:2s;}
@keyframes ripple{0%,100%{opacity:.1;}50%{opacity:.45;}}
.splash-title{font-family:'Cinzel',serif;font-size:clamp(1.2rem,4vw,1.9rem);letter-spacing:.25em;color:var(--navy);margin-bottom:5px;}
.splash-sub{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.05rem;color:var(--gold);letter-spacing:.15em;margin-bottom:34px;}
.splash-btn{background:var(--navy);color:var(--gold3);border:none;padding:14px 50px;font-family:'Cinzel',serif;font-size:.8rem;letter-spacing:.22em;cursor:pointer;text-transform:uppercase;transition:all .4s;box-shadow:0 4px 20px rgba(26,47,78,.22);}
.splash-btn:hover{background:var(--gold);color:var(--navy);}
.splash-note{margin-top:13px;color:rgba(44,36,22,.3);font-size:.7rem;letter-spacing:.1em;}

/* ── MUSIC BTN ── */
#musicBtn{position:fixed;bottom:28px;right:28px;width:50px;height:50px;background:var(--navy);border:1px solid var(--gold2);border-radius:50%;color:var(--gold3);font-size:1.2rem;cursor:pointer;z-index:8000;display:none;align-items:center;justify-content:center;transition:all .3s;box-shadow:0 4px 15px rgba(0,0,0,.2);}
#musicBtn:hover{background:var(--gold);color:var(--navy);}
#yt-player{position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;bottom:0;right:0;}

/* ── SITE ── */
#site{display:none;min-height:100vh;}

/* ── HEADER ── */
.site-header{position:fixed;top:0;left:0;right:0;z-index:500;background:rgba(253,248,240,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 4%;display:flex;align-items:center;justify-content:space-between;height:68px;}
.hdr-brand{display:flex;align-items:center;gap:11px;cursor:pointer;}
.hdr-logo{width:42px;height:42px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(184,134,42,.4);}
.hdr-text{font-family:'Cinzel',serif;font-size:.82rem;letter-spacing:.13em;color:var(--navy);}
.hdr-text small{display:block;font-family:'Raleway',sans-serif;font-size:.58rem;letter-spacing:.1em;color:var(--muted);font-weight:300;}
.hdr-nav{display:flex;align-items:center;gap:2px;}
.nav-link{color:var(--text2);text-decoration:none;font-family:'Raleway',sans-serif;font-size:.67rem;letter-spacing:.13em;text-transform:uppercase;padding:8px 11px;cursor:pointer;transition:color .3s;border:none;background:none;border-bottom:2px solid transparent;font-weight:500;}
.nav-link:hover{color:var(--gold);}
.nav-link.active{color:var(--navy);border-bottom-color:var(--gold);}
.nav-toggle{display:none;background:none;border:none;color:var(--navy);font-size:1.5rem;cursor:pointer;padding:8px;}

/* ── PAGES ── */
.page{display:none;padding-top:68px;min-height:100vh;animation:fadeUp .5s ease;}
.page.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

/* ══ PAGE 1: HOME ══ */
.hero{position:relative;min-height:calc(100vh - 68px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:80px 20px 0;overflow:hidden;}
.hero-bg{position:absolute;inset:0;background:url('mywebsite/background_image.png') center/cover no-repeat;}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(253,248,240,.82) 0%,rgba(253,248,240,.62) 40%,rgba(253,248,240,.93) 100%);}
.hero-content{position:relative;z-index:2;max-width:780px;margin-bottom:50px;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border);padding:6px 18px;font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--gold);font-size:.9rem;letter-spacing:.14em;margin-bottom:22px;background:rgba(253,248,240,.75);}
.hero-title{font-family:'Cinzel',serif;font-weight:700;font-size:clamp(1.8rem,5.5vw,4rem);color:var(--navy);line-height:1.15;margin-bottom:12px;letter-spacing:.04em;}
.hero-title em{color:var(--gold);font-style:normal;}
.hero-subtitle{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.95rem,2vw,1.3rem);color:var(--text2);margin-bottom:18px;letter-spacing:.07em;}
.hero-divider{width:75px;height:1.5px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:0 auto 22px;}
.hero-desc{max-width:540px;margin:0 auto 38px;font-size:.9rem;line-height:1.95;color:var(--text2);font-weight:300;}
.hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
.btn-primary{background:var(--navy);color:var(--gold3);padding:13px 35px;font-family:'Cinzel',serif;font-size:.74rem;letter-spacing:.17em;cursor:pointer;border:none;text-transform:uppercase;transition:all .35s;box-shadow:0 4px 18px rgba(26,47,78,.2);}
.btn-primary:hover{background:var(--gold);color:var(--navy);}
.btn-secondary{background:transparent;color:var(--navy);padding:13px 35px;font-family:'Cinzel',serif;font-size:.74rem;letter-spacing:.17em;cursor:pointer;border:1.5px solid var(--navy);text-transform:uppercase;transition:all .35s;}
.btn-secondary:hover{background:var(--navy);color:var(--cream);}
.pillars-strip{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border);background:rgba(245,237,224,.9);backdrop-filter:blur(6px);position:relative;z-index:2;}
.pillar{padding:28px 22px;text-align:center;border-right:1px solid var(--border);transition:background .3s;}
.pillar:last-child{border-right:none;}
.pillar:hover{background:rgba(184,134,42,.07);}
.pillar-icon{font-size:1.7rem;display:block;margin-bottom:9px;}
.pillar-title{font-family:'Cinzel',serif;font-size:.72rem;letter-spacing:.14em;color:var(--navy);margin-bottom:7px;text-transform:uppercase;}
.pillar-text{font-size:.77rem;color:var(--muted);line-height:1.75;font-weight:300;}

/* ══ SHARED SECTION STYLES ══ */
.sec-wrap{max-width:1000px;margin:0 auto;padding:65px 5%;}
.sec-eyebrow{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--gold);font-size:.88rem;letter-spacing:.2em;margin-bottom:9px;}
.sec-title{font-family:'Cinzel',serif;font-size:clamp(1.4rem,3.5vw,2.5rem);color:var(--navy);margin-bottom:13px;line-height:1.2;}
.sec-rule{width:55px;height:1.5px;background:var(--gold);margin-bottom:30px;}

/* ══ PAGE 2: ABOUT ══ */
.about-layout{display:grid;grid-template-columns:300px 1fr;gap:55px;align-items:start;}
.photo-wrap{position:relative;}
.photo-frame{position:absolute;top:14px;left:14px;right:-14px;bottom:-14px;border:1.5px solid var(--border);z-index:0;}
.about-photo{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:top center;border:3px solid white;box-shadow:0 10px 35px rgba(0,0,0,.11);position:relative;z-index:1;}
.about-quote{margin-top:24px;padding:16px 18px;border-left:3px solid var(--gold);background:var(--cream2);font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.95rem;color:var(--text2);line-height:1.75;}
.about-text h2{font-family:'Cinzel',serif;font-size:clamp(1.2rem,3vw,1.8rem);color:var(--navy);margin-bottom:4px;}
.about-text .role{font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--gold);font-size:1rem;letter-spacing:.07em;margin-bottom:20px;}
.about-text p{font-size:.88rem;line-height:1.95;color:var(--text2);margin-bottom:15px;font-weight:300;}
.about-text strong{font-weight:600;color:var(--navy);}
.tags{display:flex;flex-wrap:wrap;gap:7px;margin:20px 0;}
.tag{border:1px solid rgba(184,134,42,.3);color:var(--gold);padding:4px 12px;font-size:.67rem;letter-spacing:.11em;font-family:'Cinzel',serif;text-transform:uppercase;background:rgba(184,134,42,.04);}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);margin-top:28px;}
.stat{background:var(--cream);padding:17px 12px;text-align:center;}
.stat-num{font-family:'Cormorant Garamond',serif;font-size:2.1rem;color:var(--gold);display:block;line-height:1;}
.stat-lbl{font-size:.65rem;color:var(--muted);letter-spacing:.1em;margin-top:4px;text-transform:uppercase;}

/* ══ PAGE 3: PUBLICATIONS ══ */
.books-banner{background:url('mywebsite/background_image.png') center/cover no-repeat;position:relative;padding:65px 5%;text-align:center;}
.books-banner-overlay{position:absolute;inset:0;background:rgba(253,248,240,.88);}
.books-banner-content{position:relative;z-index:1;}
.books-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(265px,1fr));gap:18px;padding:45px 5%;max-width:1100px;margin:0 auto;}
.book-card{background:white;border:1px solid rgba(184,134,42,.14);padding:26px 22px;transition:all .35s;position:relative;overflow:hidden;}
.book-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--gold),var(--gold3));transform:scaleX(0);transform-origin:left;transition:transform .35s;}
.book-card:hover{box-shadow:0 8px 28px rgba(0,0,0,.09);transform:translateY(-3px);}
.book-card:hover::before{transform:scaleX(1);}
.book-num{font-family:'Cormorant Garamond',serif;font-size:2.6rem;color:rgba(184,134,42,.13);font-weight:600;position:absolute;top:12px;right:16px;line-height:1;}
.book-title{font-family:'Cinzel',serif;font-size:.82rem;color:var(--navy);margin-bottom:7px;letter-spacing:.04em;line-height:1.4;padding-right:28px;}
.book-desc{font-size:.8rem;color:var(--muted);line-height:1.75;font-weight:300;}
.book-tag{display:inline-block;margin-top:11px;padding:3px 9px;font-size:.63rem;letter-spacing:.1em;font-family:'Cinzel',serif;border:1px solid var(--border);color:var(--gold);text-transform:uppercase;}

/* ══ PAGE 4: RESEARCH ══ */
.research-hero{background:linear-gradient(135deg,var(--navy) 0%,#1e3d6b 100%);padding:65px 5%;text-align:center;}
.research-hero .sec-title{color:#f5ede0;}
.research-hero .sec-eyebrow{color:var(--gold3);}
.research-hero .sec-rule{background:var(--gold3);margin:0 auto 16px;}
.research-hero p{color:rgba(245,224,168,.72);font-size:.88rem;line-height:1.9;max-width:580px;margin:0 auto;}
.research-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));max-width:1100px;margin:0 auto;}
.research-card{padding:32px 28px;border-bottom:1px solid var(--border);border-right:1px solid var(--border);transition:background .3s;}
.research-card:hover{background:rgba(184,134,42,.05);}
.rc-icon{font-size:1.9rem;margin-bottom:12px;display:block;}
.rc-title{font-family:'Cinzel',serif;font-size:.87rem;color:var(--navy);margin-bottom:9px;letter-spacing:.06em;}
.rc-text{font-size:.8rem;color:var(--text2);line-height:1.85;font-weight:300;}
.protocol-banner{background:var(--navy2);padding:55px 5%;text-align:center;}
.protocol-banner h3{font-family:'Cinzel',serif;font-size:clamp(1.1rem,3vw,1.9rem);color:var(--gold3);letter-spacing:.07em;margin-bottom:14px;}
.protocol-banner p{color:rgba(245,237,224,.6);font-size:.86rem;line-height:1.9;max-width:640px;margin:0 auto 24px;}
.protocol-steps{display:flex;justify-content:center;flex-wrap:wrap;max-width:900px;margin:0 auto;}
.p-step{flex:1;min-width:155px;padding:22px 16px;text-align:center;border-right:1px solid rgba(201,151,58,.12);}
.p-step:last-child{border-right:none;}
.p-step-num{font-family:'Cormorant Garamond',serif;font-size:2.4rem;color:var(--gold3);opacity:.4;display:block;line-height:1;}
.p-step-title{font-family:'Cinzel',serif;font-size:.7rem;color:var(--gold3);letter-spacing:.1em;margin:5px 0;}
.p-step-text{font-size:.73rem;color:rgba(245,237,224,.45);line-height:1.7;font-weight:300;}

/* ══ PAGE 5: MEDIA ══ */
.media-header{background:var(--cream2);padding:55px 5%;text-align:center;border-bottom:1px solid var(--border);}
.videos-wrap{max-width:1000px;margin:0 auto;padding:45px 5%;}
.v-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
.v-card{border-radius:4px;overflow:hidden;position:relative;padding-bottom:56.25%;height:0;box-shadow:0 6px 22px rgba(0,0,0,.1);}
.v-card iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0;}
.v-label{font-family:'Cinzel',serif;font-size:.7rem;letter-spacing:.12em;color:var(--gold);text-transform:uppercase;margin-top:9px;}

/* ══ PAGE 6: PHILOSOPHY ══ */
.philosophy-banner{background:url('mywebsite/background_image.png') center 30%/cover no-repeat;position:relative;padding:90px 5%;text-align:center;}
.phil-overlay{position:absolute;inset:0;background:rgba(253,248,240,.85);}
.phil-content{position:relative;z-index:1;}
.phil-content blockquote{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(1.2rem,3vw,2.1rem);color:var(--navy);line-height:1.6;max-width:680px;margin:0 auto 14px;}
.phil-content cite{font-family:'Cinzel',serif;font-size:.73rem;color:var(--gold);letter-spacing:.15em;text-transform:uppercase;}
.concepts-subhead{background:var(--cream2);padding:45px 5%;text-align:center;border-bottom:1px solid var(--border);}
.concepts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));}
.concept{padding:32px 25px;text-align:center;border-right:1px solid var(--border);border-bottom:1px solid var(--border);background:white;transition:background .3s;}
.concept:hover{background:var(--cream2);}
.concept-symbol{font-family:'Cormorant Garamond',serif;font-size:2.8rem;color:var(--gold);display:block;margin-bottom:11px;line-height:1;}
.concept-title{font-family:'Cinzel',serif;font-size:.77rem;color:var(--navy);letter-spacing:.11em;margin-bottom:7px;text-transform:uppercase;}
.concept-text{font-size:.78rem;color:var(--muted);line-height:1.8;font-weight:300;}

/* ══ PAGE 7: CONTACT ══ */
.contact-split{display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 68px);}
.contact-left{background:url('mywebsite/background_image.png') center/cover no-repeat;position:relative;display:flex;align-items:center;justify-content:center;padding:60px 40px;}
.contact-left-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(26,47,78,.9),rgba(15,30,52,.94));}
.contact-left-content{position:relative;z-index:1;text-align:center;color:white;}
.contact-photo{width:110px;height:110px;border-radius:50%;object-fit:cover;object-position:top center;border:3px solid rgba(200,160,60,.45);box-shadow:0 0 0 8px rgba(200,160,60,.08);margin-bottom:18px;}
.contact-left-content h3{font-family:'Cinzel',serif;font-size:1.15rem;color:var(--gold3);letter-spacing:.1em;margin-bottom:4px;}
.contact-left-content .c-role{font-family:'Cormorant Garamond',serif;font-style:italic;color:rgba(245,224,168,.65);font-size:.92rem;margin-bottom:24px;}
.ci{display:flex;align-items:flex-start;gap:11px;margin-bottom:14px;text-align:left;}
.ci-icon{color:var(--gold3);font-size:.95rem;margin-top:2px;flex-shrink:0;}
.ci-text{font-size:.82rem;color:rgba(255,255,255,.72);line-height:1.6;}
.ci-text a{color:var(--gold3);text-decoration:none;}
.ci-text a:hover{text-decoration:underline;}
.collab-note{margin-top:26px;padding-top:20px;border-top:1px solid rgba(200,160,60,.18);font-family:'Cormorant Garamond',serif;font-style:italic;color:rgba(245,224,168,.6);font-size:.9rem;line-height:1.75;}
.contact-right{background:var(--cream);padding:55px 48px;display:flex;flex-direction:column;justify-content:center;}
.contact-right p{font-size:.87rem;color:var(--text2);line-height:1.85;margin-bottom:26px;font-weight:300;}
.form-group{margin-bottom:16px;}
.form-group label{display:block;font-family:'Cinzel',serif;font-size:.66rem;letter-spacing:.14em;color:var(--navy);margin-bottom:6px;text-transform:uppercase;}
.form-group input,.form-group textarea{width:100%;padding:10px 13px;border:1px solid rgba(184,134,42,.25);background:white;font-family:'Raleway',sans-serif;font-size:.87rem;color:var(--text);outline:none;transition:border .3s;font-weight:300;}
.form-group input:focus,.form-group textarea:focus{border-color:var(--gold);}
.form-group textarea{height:105px;resize:vertical;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.submit-btn{width:100%;background:var(--navy);color:var(--gold3);padding:13px;border:none;font-family:'Cinzel',serif;font-size:.76rem;letter-spacing:.2em;cursor:pointer;text-transform:uppercase;transition:all .35s;margin-top:4px;}
.submit-btn:hover{background:var(--gold);color:var(--navy);}

/* ══ FOOTER ══ */
.site-footer{background:var(--navy2);color:rgba(245,237,224,.45);padding:26px 5%;text-align:center;font-size:.73rem;letter-spacing:.1em;border-top:1px solid rgba(184,134,42,.15);}
.site-footer span{color:var(--gold);font-family:'Cinzel',serif;}

/* ══ RESPONSIVE ══ */
@media(max-width:900px){
  .hdr-nav{display:none;position:fixed;top:68px;left:0;right:0;background:rgba(253,248,240,.98);flex-direction:column;padding:16px;border-bottom:1px solid var(--border);gap:4px;backdrop-filter:blur(10px);}
  .hdr-nav.open{display:flex;}
  .nav-toggle{display:block;}
  .about-layout{grid-template-columns:1fr;}
  .photo-wrap{max-width:240px;margin:0 auto;}
  .pillars-strip{grid-template-columns:1fr;}
  .v-grid{grid-template-columns:1fr;}
  .contact-split{grid-template-columns:1fr;}
  .contact-right{padding:40px 24px;}
  .form-row{grid-template-columns:1fr;}
  .protocol-steps{flex-direction:column;}
  .p-step{border-right:none;border-bottom:1px solid rgba(201,151,58,.12);}
}
@media(max-width:560px){
  .books-grid{grid-template-columns:1fr;}
  .concepts-grid{grid-template-columns:1fr 1fr;}
  .hero-btns{flex-direction:column;align-items:center;}
  .stats-row{grid-template-columns:1fr 1fr;}
}
</style>
</head>
<body>

<!-- ───────── SPLASH ───────── -->
<div id="splash">
  <div class="splash-bg"></div>
  <div class="splash-overlay"></div>
  <div class="splash-rings">
    <div class="ring"></div><div class="ring"></div><div class="ring"></div>
  </div>
  <div class="splash-content">
    <img src="mywebsite/logo.jpg" alt="Aesthetics of Society" class="splash-logo">
    <div class="splash-om">ॐ</div>
    <div class="splash-title">CULTURAL MUSINGS</div>
    <div class="splash-sub">Aesthetics of Society</div>
    <button class="splash-btn" onclick="enterSite()">♩ Enter with Music</button>
    <div class="splash-note">Click to begin — Carnatic flute will play softly</div>
  </div>
</div>

<!-- ───────── MUSIC ───────── -->
<button id="musicBtn" onclick="toggleMusic()" title="Toggle music">♩</button>
