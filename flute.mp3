<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
var MUSIC_ID = "NBrVKBYQd_M";
var musicOn = false;

function enterSite(){
  var s = document.getElementById('splash');
  s.style.opacity = '0';
  setTimeout(function(){ s.style.display='none'; }, 1400);
  document.getElementById('site').style.display = 'block';
  document.getElementById('musicBtn').style.display = 'flex';
  playMusic();
}

function playMusic(){
  document.getElementById('yt-player').src =
    'https://www.youtube.com/embed/'+MUSIC_ID+
    '?autoplay=1&mute=0&loop=1&playlist='+MUSIC_ID+'&controls=0';
  musicOn = true;
  document.getElementById('musicBtn').innerHTML = '⏸';
  document.getElementById('musicBtn').title = 'Pause music';
}

function toggleMusic(){
  if(musicOn){
    document.getElementById('yt-player').src = 'about:blank';
    musicOn = false;
    document.getElementById('musicBtn').innerHTML = '♩';
    document.getElementById('musicBtn').title = 'Play music';
  } else { playMusic(); }
}

function showPage(name){
  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('active'); });
  document.querySelectorAll('.nav-link').forEach(function(l){ l.classList.remove('active'); });
  var pg = document.getElementById('page-'+name);
  if(pg) pg.classList.add('active');
  document.querySelectorAll('.nav-link').forEach(function(l){
    if(l.getAttribute('onclick') && l.getAttribute('onclick').indexOf("'"+name+"'") > -1)
      l.classList.add('active');
  });
  document.getElementById('mainNav').classList.remove('open');
  window.scrollTo({top:0,behavior:'sm
