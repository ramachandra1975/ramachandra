</script>

<!-- VEDIC AUDIO -->
<audio id="vedic-audio" loop>
  <source src="audio/vedic-tamil.mp3" type="audio/mpeg">
</audio>

<script>
const audio = document.getElementById("vedic-audio");
let started = false;

function fadeInAudio() {
  audio.volume = 0;
  audio.play();

  let vol = 0;
  const fade = setInterval(() => {
    if (vol < 0.2) {
      vol += 0.01;
      audio.volume = vol;
    } else {
      clearInterval(fade);
    }
  }, 200);
}

document.addEventListener("click", function init() {
  if (!started) {
    fadeInAudio();
    started = true;
  }
});
</script>

</body>
</html>
