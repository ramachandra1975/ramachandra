</script>

  const audio = document.getElementById('vedic-audio');
  const musicIcon = document.getElementById('music-icon');
  const musicStatus = document.getElementById('music-status');
  const musicBars = document.getElementById('music-bars');
  let isPlaying = false;

  function fadeVolume(targetVol, duration, callback) {
    const startVol = audio.volume;
    const steps = 30;
    const interval = duration / steps;
    const step = (targetVol - startVol) / steps;
    let count = 0;
    const timer = setInterval(() => {
      count++;
      audio.volume = Math.max(0, Math.min(1, startVol + step * count));
      if (count >= steps) {
        clearInterval(timer);
        audio.volume = targetVol;
        if (callback) callback();
      }
    }, interval);
  }

  function toggleMusic() {
    if (!isPlaying) {
      audio.currentTime = 0;
      audio.volume = 0;
      const playPromise = audio.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          isPlaying = true;
          fadeVolume(0.25, 2000);
          musicIcon.textContent = '⏸';
          musicStatus.textContent = 'Now Playing';
          musicBars.style.opacity = '1';
        }).catch(err => {
          musicStatus.textContent = 'Click ▶ to play';
          console.log('Audio play error:', err);
        });
      }
    } else {
      fadeVolume(0, 1000, () => {
        audio.pause();
        isPlaying = false;
        musicIcon.textContent = '▶';
        musicStatus.textContent = 'Click to play';
        musicBars.style.opacity = '0';
      });
    }
  }

  // Try on first user interaction (scroll, touch, keydown)
  let audioStarted = false;
  function tryStart() {
    if (!audioStarted) {
      audioStarted = true;
      toggleMusic();
    }
  }
</body>
</html>
